{
  "name": "pi-fastcrw",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Lean pi extension for fastCRW web search, scraping and extraction",
  "keywords": ["pi-package", "pi", "pi-extension", "fastcrw", "web-scraping"],
  "pi": { "extensions": ["./index.ts"] },
  "files": ["index.ts", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext index.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "typebox": "1.3.27",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
