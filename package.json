{
  "name": "pi-fastcrw",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Native pi tools for fastCRW search, scraping, jobs, changes, PDF parsing, research and optional hosted monitors",
  "keywords": ["pi-package", "pi", "pi-extension", "fastcrw", "web-scraping", "web-search", "research"],
  "author": { "name": "xander", "url": "https://github.com/lued" },
  "repository": { "type": "git", "url": "git+https://github.com/lued/pi-fastcrw.git" },
  "homepage": "https://github.com/lued/pi-fastcrw#readme",
  "bugs": { "url": "https://github.com/lued/pi-fastcrw/issues" },
  "publishConfig": { "access": "public" },
  "pi": { "image": "https://raw.githubusercontent.com/lued/pi-fastcrw/main/docs/images/session.png", "extensions": ["./index.ts"] },
  "files": ["index.ts", "README.md", "docs", "SECURITY.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=22.19" },
  "scripts": {
    "check": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext index.ts test.mts smoke.mts",
    "test": "node --test test.mts",
    "smoke": "node smoke.mts",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "typebox": "1.4.2",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
